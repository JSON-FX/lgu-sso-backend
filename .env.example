# ---- lgu-ecosystem:start ----
# LGU Ecosystem — See ../CLAUDE.md for the full ecosystem overview.
#
# Dev↔Prod parity rule: dev and prod configs MUST differ only in DNS
# hostnames, secrets, and APP_ENV/NODE_ENV/APP_DEBUG. If you find yourself
# diverging anything else between environments, stop and re-read the rule.
#
# Two SSO hosts, two purposes:
#   - Login redirect: sso-portal.local (dev) / sso-portal.lguquezon.local (prod)
#   - SSO API:        api.sso.local    (dev) / api.sso.lguquezon.local    (prod)
# Never sso-ui.*, never lgu-sso.test, never lgu-sso.local.
# ---- lgu-ecosystem:end ----

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lgu_sso
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- lgu-ecosystem-sso:start ----
# SSO server-side configuration. See ../CLAUDE.md → Authentication Model.
# Parity rule: cookie name/domain/flags in consumers MUST match these exactly.

# Shared SSO cookie written by this server, read by all consumer apps.
SSO_COOKIE_NAME=lgu_sso_token
# Cookie domain is the TOP-LEVEL parent so every sibling app can read it.
# Dev:  .local                Prod: .lguquezon.local
# Do NOT set this to .sso.local / .sso.lguquezon.local — that would hide
# the cookie from sibling apps and break cross-app SSO.
SSO_COOKIE_DOMAIN=.local
# Prod: SSO_COOKIE_DOMAIN=.lguquezon.local
SSO_COOKIE_SECURE=false
# Prod: SSO_COOKIE_SECURE=true
SSO_COOKIE_SAME_SITE=lax
SSO_COOKIE_LIFETIME=1440

# CORS allow-list for cross-origin requests from consumer apps.
# Include every consumer (and the portal) under both dev and prod hosts
# as appropriate for the environment.
# Dev:
SSO_ALLOWED_ORIGINS=http://opts.local,http://chat.local,http://sso-portal.local
# Prod: SSO_ALLOWED_ORIGINS=https://opts.lguquezon.local,https://chat.lguquezon.local,https://sso-portal.lguquezon.local

JWT_TTL=1440

CHAT_WEBHOOK_URL=
CHAT_WEBHOOK_SECRET=
# ---- lgu-ecosystem-sso:end ----
